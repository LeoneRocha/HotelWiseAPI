    <PackageVersion Include="CommunityToolkit.VectorData.InMemory" Version="1.0.1" />
    <PackageVersion Include="CommunityToolkit.VectorData.Qdrant" Version="1.0.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.30" />
