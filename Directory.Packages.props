    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.MistralAI" Version="1.80.0-alpha" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.80.0-alpha" />
