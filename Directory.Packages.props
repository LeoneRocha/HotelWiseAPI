    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />

    <!-- Bloco AI -->
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.80.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Abstractions" Version="1.80.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Core" Version="1.80.0" />
