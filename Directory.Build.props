<Project>
  <PropertyGroup>
    <!-- Suppress Obsolete / Deprecation and XML doc warnings for C# compiler and Sonar analyzers -->
    <NoWarn>$(NoWarn);CS0618;CS0612;S1133;S1874;CS1591;CS1574</NoWarn>

    <!-- Usa o SmartCoreHub.Core.SDK via NuGet (não local) -->
    <UseLocalSmartCoreHub>false</UseLocalSmartCoreHub>
  </PropertyGroup>
</Project>
