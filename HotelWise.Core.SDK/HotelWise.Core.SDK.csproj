<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.1;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HotelWise.Core.SDK</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5104;SKEXP0050;SKEXP0001;SKEXP0010;SKEXP0070;SKEXP0110</NoWarn>

    <!-- NuGet -->
    <PackageId>HotelWise.Core.SDK</PackageId>
    <Version>1.0.0</Version>
    <Authors>HotelWise</Authors>
    <Company>HotelWise</Company>
    <Description>Núcleo reutilizável do ecossistema HotelWise — abstrações, helpers, infraestrutura genérica e AI core.</Description>
    <PackageTags>hotelwise;sdk;core;ai;efcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Casca: implementação canônica vive em SmartCoreHub.Core.SDK (NuGet). -->
  <ItemGroup>
    <PackageReference Include="SmartCoreHub.Core.SDK" />
  </ItemGroup>

  <!-- Dependências leves (todos os TFMs) -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="System.ComponentModel.Annotations" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- Dependências multi-plataforma modernas (net10.0 e net8.0) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' OR '$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Abstractions" />
    <PackageReference Include="Microsoft.SemanticKernel.Core" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" />
    <PackageReference Include="Microsoft.SemanticKernel.PromptTemplates.Handlebars" />
    <PackageReference Include="Microsoft.SemanticKernel.Plugins.Memory" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.MistralAI" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="CommunityToolkit.VectorData.InMemory" />
    <PackageReference Include="CommunityToolkit.VectorData.Qdrant" />
    <PackageReference Include="Mistral.SDK" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- JwtBearer: versão alinhada à plataforma (não entra no shared framework) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" VersionOverride="8.0.16" />
  </ItemGroup>

  <!-- GroqApiLibrary: embutido no SmartCoreHub.Core.SDK (Infrastructure.AI.ThirdParty). -->
  <!-- ProjectReference removido na casca para evitar CS0433 (GroqApiClient duplicado). -->

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="_tools\**" />
    <None Include="_tools\**" />
  </ItemGroup>
</Project>
